# Keil MDK 构建产物
Objects/
Listings/
DebugConfig/
*.build_log.htm
*.axf
*.hex
# release 里的 hex 要入库（否则被上面的 *.hex 挡掉）
!release/APP.hex
!release/*.hex
*.lnp
*.crf
*.d
*.o
*.htm
*.sct
*.log
build.log
# release 里的构建日志要入库
!release/build.log
# evidence 里的原始日志是"证据"，必须入库
# （2026-11-11 复查发现：上面这条 *.log 把 65 个证据日志全部挡在仓库外，
#   导致证据矩阵引用的 .log 一个都不在仓库里，[实测] 的"可复跑"定义落空）
!evidence/**/*.log

# Keil 用户/调试配置（每人一份，不入库）
*.uvguix.*
*.uvoptx
*.uvprojx.bak*
JLinkLog.txt

# 备份与临时文件
*.bak
*.bak-*
_编码转换备份_*/
*.tmp

# 0 字节残留文件（待确认后删除，先不入库）
/AD.c
/LightCensor.c
/LightCensor.h
/LightSensor.c
/LightSensor.h

# FreeRTOS 原始英文版备份副本（与正式目录重复）
FreeRTOS/_原始英文版备份/

# 编辑器 / 脚本
.vscode/
*.code-workspace
__pycache__/

# Keil 事件记录器桩
/EventRecorderStub.scvd
/Boot/EventRecorderStub.scvd

# 一次性补丁/抓包脚本（跑完就没用了，不入库）
_临时脚本/

# 卡压力测试的运行状态（每次跑都会重建，不入库）
evidence/card_health/card_stress_state.json

# 派生缓存与编译产物（2026-11-16 加：标注会话的 npy 缓存、验证用 exe）
# 为什么：session*.npy 是 1.9MB+900KB 的中间数据，可由 collect_labels.py 重跑得到；
#        verify_model.exe 可由 verify_model.c 编译得到。都不该进仓库。
evidence/**/*.npy
evidence/**/*.exe
evidence/**/that
# 损坏的中间文件（2026-11-23 编码事故留下的 .damaged-YYYYMMDD 副本，不入库）
*.damaged-*

# release 里的裸固件 .bin 是调试产物（2026-11-25 清点：17 个未跟踪，共 1.32MB）
# 注：已入库的 APP.bin / APP_v5_20261107.bin / BOOT.bin 不受影响（.gitignore 只管未跟踪文件）
#     hex 照旧入库，见上面 !release/*.hex
release/*.bin
